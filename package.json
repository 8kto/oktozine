{
  "name": "ttrpg-module-behind-the-eye-of-vargothar",
  "version": "1.11.23",
  "description": "TTRPG Module",
  "author": "undefined Okto",
  "scripts": {
    "build": "yarn build:main",
    "build:main": "yarn build:styles && tsx scripts/oktozine/build-module.ts main --html-no-skip",
    "build:clean": "node scripts/release/clean-build.mjs --dir build/release",
    "build:all": "yarn build:styles && tsx scripts/oktozine/build-module.ts --html-no-skip; yarn build:bestiaries",
    "build:styles": "npx tailwindcss -i ./src/styles/styles.css -o ./build/output.css",
    "build:bestiary": "scripts/build/build-bestiary.sh --id bestiary",
    "build:map": "yarn build:styles && tsx scripts/oktozine/build-module.ts map --no-skip-html",
    "build:osr": "yarn build:styles && tsx scripts/oktozine/build-module.ts osr --no-skip-html",
    "build:bestiary-osr": "scripts/build/build-bestiary.sh --id bestiary-osr",
    "build:bestiaries": "yarn build:bestiary && scripts/build/build-bestiary.sh --id bestiary-osr --cache",
    "build-prod": "sh -c 'banner PROD BUILD; BUILD_MODE=production yarn build:$1; banner PROD BUILD END;' --",
    "build-prod:all": "sh -c 'banner PROD BUILD; export BUILD_MODE=production; yarn build:all && ./scripts/release/bookmark-release-pdfs.sh && banner PROD BUILD END;' --",
    "dev": "npx http-server ./build/chunks-html -p 3001 --cors",
    "dev:radar": "npx live-server --port=3010 --no-browser maps/crt/",
    "dev:add-links-to-map": "npx live-server --port=3011 --no-browser maps/add-links-to-map/",
    "format": "prettier . --check",
    "format:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.d.ts --fix && prettier --write .",
    "pdf:accept": "node scripts/pdf-visual-diff/pdf-run.mjs accept",
    "pdf:baseline": "node scripts/pdf-visual-diff/pdf-run.mjs baseline",
    "pdf:diff": "node scripts/pdf-visual-diff/pdf-run.mjs diff",
    "pdf:update": "node scripts/pdf-visual-diff/pdf-run.mjs update",
    "pdf:open": "node scripts/pdf-visual-diff/pdf-run.mjs open",
    "radar:get-token": "(cd maps/crt/; node gm-link.js http://localhost:3010/ grounds)",
    "radar:deploy": "./scripts/deploy-radar-map.sh",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.d.ts",
    "release-check": "node scripts/release/check-release.mjs",
    "release": "./scripts/release/release.sh",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "watch:styles": "yarn build:styles --watch"
  },
  "private": true,
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "chalk": "^5.3.0",
    "deepmerge": "^4.3.1",
    "ejs": "^3.1.9",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "html-pdf": "^3.0.1",
    "hyphenation.ru": "^0.2.1",
    "hyphenopoly": "^5.3.0",
    "hypher": "^0.2.5",
    "jsdom": "^27.0.0",
    "markdown-it": "^14.0.0",
    "markdown-it-ins": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.7.0",
    "tailwindcss": "^3.4.1",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@babel/plugin-syntax-import-assertions": "^7.23.3",
    "@babel/preset-env": "^7.23.9",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "eslint": "^8",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.0.2",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint": "^0.8.19",
    "nodemon": "^3.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
