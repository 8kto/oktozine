{
  "name": "ttrpg-module-behind-the-eye-of-vargothar",
  "version": "1.9.17",
  "description": "TTRPG Module",
  "author": "undefined",
  "scripts": {
    "build": "yarn build:styles && scripts/build-module.mjs main --html-no-skip",
    "build:all": "yarn build:styles && scripts/build-module.mjs --html-no-skip; yarn build:bestiary",
    "build:styles": "npx tailwindcss -i ./src/styles/styles.css -o ./build/output.css",
    "build:bestiary": "./scripts/build-bestiary.sh",
    "build:map": "yarn build:styles && ./scripts/build-module.mjs map --no-skip-html",
    "dev": "npx http-server ./build/chunks-html -p 3001 --cors",
    "dev:radar": "npx live-server --port=3010 --no-browser maps/ascii/grounds/",
    "format": "prettier . --check",
    "format:fix": "yarn lint --fix && prettier --write .",
    "radar:get-token": "(cd maps/ascii/grounds/; node gm-link.js http://localhost:3010/ grounds)",
    "radar:deploy": "./scripts/deploy-radar-map.sh",
    "lint": "eslint",
    "release": "./scripts/release/release.sh",
    "test": "jest",
    "watch:styles": "yarn build:styles --watch"
  },
  "private": true,
  "dependencies": {
    "chalk": "^5.3.0",
    "deepmerge": "^4.3.1",
    "ejs": "^3.1.9",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "html-pdf": "^3.0.1",
    "hyphenation.ru": "^0.2.1",
    "hyphenopoly": "^5.3.0",
    "hypher": "^0.2.5",
    "jsdom": "^27.0.0",
    "markdown-it": "^14.0.0",
    "markdown-it-ins": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.7.0",
    "tailwindcss": "^3.4.1",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@babel/plugin-syntax-import-assertions": "^7.23.3",
    "@babel/preset-env": "^7.23.9",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "eslint": "^8",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.0.2",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint": "^0.8.19",
    "nodemon": "^3.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.7"
  },
  "imports": {
    "#lib/*": "./scripts/lib/*",
    "#commands/*": "./scripts/commands/*"
  }
}
